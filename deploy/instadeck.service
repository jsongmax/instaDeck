[Unit]
Description=InstaDeck panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=instadeck
Group=instadeck
WorkingDirectory=/var/lib/instadeck
EnvironmentFile=/etc/instadeck/instadeck.env
LoadCredential=master.key:/etc/instadeck/master.key
Environment=INSTADECK_MASTER_KEY_FILE=%d/master.key
ExecStart=/opt/instadeck/instadeck serve
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StateDirectory=instadeck
StateDirectoryMode=0700
ReadWritePaths=/var/lib/instadeck

[Install]
WantedBy=multi-user.target
